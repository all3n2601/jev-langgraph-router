{
  "name": "jev-router-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Typed, confidence-aware routing for AI applications using Jev.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "pnpm --recursive --if-present clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/ai-sdk/tests/live",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter jev-router-core build && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
