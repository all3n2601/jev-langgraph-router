{
  "name": "jev-langgraph-router",
  "version": "0.0.0",
  "description": "Typed, confidence-aware Jev routing for LangGraph.js.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "jev-ai-sdk-router": "workspace:*",
    "jev-router-core": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/langgraph": ">=1.4.17 <2"
  },
  "devDependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "zod": "4.6.5"
  }
}
