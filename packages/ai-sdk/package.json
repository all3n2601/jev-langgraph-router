{
  "name": "jev-ai-sdk-router",
  "version": "0.0.0",
  "description": "AI SDK adapter for typed Jev routing.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "jev-router-core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=7.0.105 <8"
  },
  "devDependencies": {
    "ai": "7.0.110"
  }
}
