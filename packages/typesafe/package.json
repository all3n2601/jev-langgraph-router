{
  "name": "jev-typesafe-router",
  "version": "0.0.0",
  "description": "Direct TypeSafe Jev adapter for typed routing.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "jev-router-core": "workspace:*"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": ">=0.6.0 <1"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  }
}
